{
  "name": "boardtasks",
  "productName": "BoardTasks",
  "version": "0.1.0",
  "description": "A premium Google Tasks desktop client for macOS",
  "private": true,
  "type": "commonjs",
  "main": "out/main/index.js",
  "author": "BoardTasks",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "_versionNotes": [
    "vite MUST stay on 7.x: electron-vite@5 peers vite ^5||^6||^7. Vite 8 breaks the build.",
    "typescript MUST stay on 5.x: typescript-eslint@8 peers typescript <6.1.0. TS 7 breaks lint.",
    "@types/node tracks Electron's bundled Node 24, not the host Node version."
  ],
  "scripts": {
    "dev": "electron-vite dev --watch",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "package:dir": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac --arm64",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run test:cov",
    "probe:api": "node scripts/api-probe.cjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/react-virtual": "3.14.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@44.4.1": true,
    "electron-winstaller@5.4.0": true
  }
}
