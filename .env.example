# BoardTasks does NOT ship Google credentials. You enter your own OAuth Desktop
# client ID + secret in the in-app setup wizard; they are stored encrypted in
# the macOS Keychain via Electron safeStorage.
#
# These env vars exist ONLY for the dev/E2E harness.
# BT_E2E=1                      # disables tray/global shortcut/auto-sync timers, enables test seams
# BT_USER_DATA=/tmp/bt-profile  # override app.getPath('userData')
# BT_GOOGLE_BASE_URL=http://127.0.0.1:4545  # point the API client at the fake Google server
# BT_FAKE_AUTH={"accessToken":"e2e","refreshToken":"e2e"}  # skip OAuth in E2E
